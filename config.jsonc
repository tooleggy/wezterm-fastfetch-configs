{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/logo2.txt",
      "color": {
        "1": "bright_black"
      }
    },
  "modules": [
    "seperator",
    "break",
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "green"
    },
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "black"
    },
    "terminalfont",
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "green"
    },
    "memory",
    "swap",
    "disk",
    {
      "type": "player",
      "key": "Player",
      "keyColor": "green"
    },
    {
      "type": "media",
      "key": "Media",
      "keyColor": "green"
    },
    "netio",
    "break",
    {
      "type": "custom",
      "key": "Hardware"
    },
    "mouse",
    "keyboard",
    "display",
    "bluetooth",
    "break",
    "colors"
  ]
}
